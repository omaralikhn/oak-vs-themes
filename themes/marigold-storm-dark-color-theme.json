  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#c3beb1",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#e67e80"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#dca561"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a7c080"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#91cbd4"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#c4a3d9"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#f0b35f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#e6c384"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#f2ead7"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#f2ead7",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#c4a3d9"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#7fb4e0"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#e67e80"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e6c384"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#c3beb1"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#91cbd4"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#dca561"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#f0b35f",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e6c384",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#91cbd4",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#91cbd4"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#c3beb1",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a7c080"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#e67e80"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#7fb4e0"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e67e80"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#91cbd4",
    "class": "#e6c384",
    "interface": "#e6c384",
    "enum": "#e6c384",
    "struct": "#e6c384",
    "typeParameter": "#e6c384",
    "type": "#e6c384",
    "function": "#f0b35f",
    "method": "#f0b35f",
    "macro": "#dca561",
    "decorator": "#dca561",
    "property": "#7fb4e0",
    "enumMember": "#c4a3d9",
    "variable": "#f2ead7",
    "variable.readonly": "#c4a3d9",
    "variable.defaultLibrary": "#c4a3d9",
    "parameter": {
      "foreground": "#f2ead7",
      "italic": true
    },
    "keyword": "#e67e80",
    "comment": {
      "foreground": "#c3beb1",
      "italic": true
    },
    "string": "#a7c080",
    "number": "#c4a3d9",
    "regexp": "#91cbd4",
    "operator": "#dca561"
  }
}
